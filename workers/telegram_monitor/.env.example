# Copy to .env (same directory) and fill in. NEVER commit the real .env or
# the *.session file that appears after your first login - both are
# already covered by the repo's .gitignore.
#
# On Windows, save this file as UTF-8 WITHOUT a BOM. Notepad and PowerShell's
# Out-File/Set-Content add one by default, and a BOM becomes part of the first
# variable's name (TG_API_ID -> "<BOM>TG_API_ID"), so that variable silently
# goes missing. config.py reads .env as utf-8-sig so it tolerates this anyway.

# From https://my.telegram.org -> API development tools (see README.md).
TG_API_ID=
TG_API_HASH=

# Name for the local Telethon session file (leadgen_session.session).
TG_SESSION=leadgen_session

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# channel_rater.py only (see README.md "Оценка каналов"):
# how many recent posts to sample per channel, and how long to pause
# between channels while reading history.
RATE_SAMPLE=50
RATE_CHANNEL_DELAY_SECONDS=2.0

# --- Channel resolution & FloodWait policy (see README.md "Кэш каналов") ---
# Resolved channels are cached in channel_cache.json, so a normal restart
# makes ZERO ResolveUsername calls. These only matter for channels the cache
# can't answer for yet.

# Pause between consecutive username resolves.
RESOLVE_DELAY_SECONDS=2.0

# How long a cached resolve stays valid before being re-checked.
CACHE_TTL_DAYS=30

# If Telegram asks for a longer FloodWait than this, stop resolving for this
# run, keep what was already resolved, and monitor those channels. The wait
# itself is always obeyed - this is a ceiling on how long we block, never a
# way around the limit.
MAX_FLOOD_WAIT_SECONDS=300

# Re-resolve every channel, ignoring the cache. Set to true after joining new
# channels, then set it back to false.
FORCE_RESOLVE=false
