# Copy to .env (same directory) and fill in. NEVER commit the real .env
# (already covered by the repo's .gitignore: workers/**/.env).
#
# On Windows, save as UTF-8 WITHOUT a BOM - a BOM becomes part of the first
# variable's name and that variable silently goes missing. (config.py reads
# .env as utf-8-sig so it tolerates one anyway.)

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# --- HH API access ---
# REQUIRED IN PRACTICE. HH's own docs for GET /vacancies say: "Если не
# передан токен авторизации, то после первого запроса будет предложено
# пройти капчу." Verified live: without a token /vacancies answers
# 403 {"errors":[{"type":"forbidden"}]}.
# Register an application at https://dev.hh.ru/admin and paste its token
# here. See README.md "Доступ к API: нужен токен".
HH_TOKEN=

# HH requires a User-Agent identifying the app, and BLACKLISTS some formats.
# Verified live: a UA containing an email ("MyApp/1.0 (me@example.com)" -
# the shape HH's older docs suggested) is rejected with
#   400 {"errors":[{"value":"blacklisted","type":"bad_user_agent"}]}
# Keep it to plain descriptive words with no email address.
HH_USER_AGENT=qorsa-leadgen-hh-worker/1.0

HH_API_BASE=https://api.hh.ru

# --- The stale-vacancy detector (the point of this worker) ---
# A vacancy still open this many days after publication reads as "we can't
# hire for this" - the moment a company starts considering outsourcing.
# Such leads are marked is_stale=true in raw.
STALE_DAYS=45

# --- Volume ---
# Max companies to ingest in one run.
TARGET_PER_DAY=300

# true = one pass and exit (good for a daily scheduled task).
# false = loop forever, sleeping LOOP_INTERVAL_HOURS between passes.
RUN_ONCE=true
LOOP_INTERVAL_HOURS=24

# HH caps per_page at 100 and total result depth at 2000 (so with
# per_page=100 the last usable page is 19). The client enforces both.
PER_PAGE=100
MAX_PAGES_PER_QUERY=5

# Pause after every HH request, and the per-request timeout.
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=30.0

# A second request per employer to read site_url (the search result does NOT
# carry it) and the employer type (which is how кадровые агентства get
# filtered using HH's own classification). Costs one request per surviving
# employer - capped by MAX_EMPLOYER_DETAILS.
FETCH_EMPLOYER_DETAILS=true
MAX_EMPLOYER_DETAILS=200

# --- Filtering (leave unset to use the built-in lists in config.py) ---
# Matched as WHOLE WORDS, case-insensitive, so "кадры" does not filter
# "Кадрырезерв Дизайн". Keep entries specific - a needle that is also an
# ordinary word silently drops real leads.
# AGENCY_STOPLIST=кадровое агентство,рекрутинг,подбор персонала
# GIANT_STOPLIST=сбербанк,яндекс,ozon,wildberries,vk,тинькофф

# HH's own employer types to skip (from /dictionaries employer_type):
# agency = Кадровое агентство, private_recruiter = Частный рекрутер.
# Only applies when FETCH_EMPLOYER_DETAILS=true.
SKIP_EMPLOYER_TYPES=agency,private_recruiter

# Skip companies HH marks as IT-accredited - they have in-house developers.
SKIP_ACCREDITED_IT=true
