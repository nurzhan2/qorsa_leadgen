# Copy to .env (same directory) and fill in. NEVER commit the real .env -
# it's already covered by the repo's .gitignore (workers/**/.env).
#
# THIS SOURCE REQUIRES A PAID FEED - see README.md "Это платно, честно"
# before spending time here. Leave everything below blank/unset and this
# worker logs "NEWDOMAINS provider not configured, exiting" and exits
# cleanly (exit code 0) - the rest of the project works fine without it.

# "whoisxml" (implemented, see README.md for signup) or "custom" (bring
# your own compatible HTTP+JSON feed - see providers.py CustomHttpProvider).
DOMAINS_PROVIDER=

DOMAINS_API_KEY=

# Only used when DOMAINS_PROVIDER=custom.
DOMAINS_API_URL=

# Comma-separated TLDs to pull (whoisxml provider only).
DOMAINS_TLDS=ru,com

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

TARGET_PER_DAY=300
RUN_ONCE=true
LOOP_INTERVAL_HOURS=24

# Per-domain HTTP check timeout when deciding hasSite (tries https then http).
SITE_CHECK_TIMEOUT_SECONDS=8.0
