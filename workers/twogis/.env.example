# Copy to .env (same directory) and fill in. NEVER commit the real .env -
# it's already covered by the repo's .gitignore (workers/**/.env).

# From dev.2gis.ru - see README.md for how to get a free key.
TWOGIS_API_KEY=

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# Max companies to ingest in one run (spread across all city x rubric pairs).
TARGET_PER_DAY=300

# true = one pass and exit (good for a daily cron job).
# false = loop forever, sleeping LOOP_INTERVAL_HOURS between passes.
RUN_ONCE=true
LOOP_INTERVAL_HOURS=24

# 2GIS free-tier pacing - lower PAGE_SIZE/MAX_CONCURRENT_REQUESTS or raise
# REQUEST_DELAY_SECONDS if you start seeing 429s.
PAGE_SIZE=20
MAX_PAGES_PER_COMBO=3
REQUEST_DELAY_SECONDS=0.34
MAX_CONCURRENT_REQUESTS=2
