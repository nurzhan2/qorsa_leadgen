# Copy to .env (same directory) and adjust. No API key needed - the
# zakupki.gov.ru search used here is public. NEVER commit the real .env -
# it's already covered by the repo's .gitignore (workers/**/.env).

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# Max companies to ingest in one run (spread across all keywords).
TARGET_PER_DAY=300

# true = one pass and exit (good for a daily cron job).
# false = loop forever, sleeping LOOP_INTERVAL_HOURS between passes.
RUN_ONCE=true
LOOP_INTERVAL_HOURS=24

RESULTS_PER_PAGE=10
MAX_PAGES_PER_KEYWORD=3
REQUEST_DELAY_SECONDS=2.0

# zakupki.gov.ru's TLS certificate is issued by a Russian CA that many
# systems outside Russia don't trust by default - if you hit an SSL/TLS
# "untrusted root" error, the honest fix is installing the Russian Trusted
# Root CA (see README.md for a link). Only set this to false if you
# understand and accept the security tradeoff of skipping certificate
# verification.
VERIFY_SSL=true
