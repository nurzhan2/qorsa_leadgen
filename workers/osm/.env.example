# Copy to .env (same directory) and adjust. No API key needed - Overpass
# is free and public. NEVER commit the real .env (already covered by the
# repo's .gitignore: workers/**/.env).
#
# On Windows, save as UTF-8 WITHOUT a BOM - a BOM becomes part of the first
# variable's name and that variable silently goes missing. (config.py reads
# .env as utf-8-sig so it tolerates one anyway.)

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# Max companies to ingest in one run (spread across the pairs this run covers).
TARGET_PER_DAY=300

# true = one pass and exit (good for a scheduled job).
# false = loop forever, sleeping LOOP_INTERVAL_HOURS between passes.
RUN_ONCE=true
LOOP_INTERVAL_HOURS=24

# Identifies this tool to Overpass. IMPORTANT (verified live, repeatedly):
# the public instance returns 406 for ANY User-Agent containing "@", a URL
# scheme ("://"), or an obfuscated-email pattern ("x at y dot z") - i.e.
# exactly the contact-info formats Overpass's own usage policy suggests.
# Keep this to plain descriptive words only. See README.md "User-Agent:
# важное ограничение" before adding contact info here.
OSM_USER_AGENT=qorsa-leadgen-osm-worker/1.0

# Overpass has no REST pagination - each (city, category) combo pulls up
# to this many elements in one query.
PAGE_SIZE=50

# Pause between every Overpass request. This is NOT optional politeness -
# the public instances block bursty clients. Raised to 5s now that the grid
# is 30 cities x 36 categories; lower it only if you run your own instance.
REQUEST_DELAY_SECONDS=5.0
REQUEST_TIMEOUT_SECONDS=75.0

# Public Overpass mirrors, tried in order. When one keeps answering 429/504
# the worker moves to the next. These mirrors exist so load can spread out;
# the same pacing and backoff apply to all of them, so this spreads load
# rather than multiplying our quota. See README.md "Этика".
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.osm.ch/api/interpreter

# --- Incremental crawling (README: "Режим постепенного обхода") ---
# 30 cities x 36 categories = 1080 Overpass queries, far too many for one
# sitting. Each run does this many pairs and checkpoints what it finished;
# the next run continues from there. ~22 runs cover the whole grid.
COMBOS_PER_RUN=50

# true = discard the checkpoint and crawl the grid from the beginning.
# Leave false for normal scheduled operation.
RESET_PROGRESS=false

# --- Data quality ---
# Comma-separated chain/franchise names to skip - they already have websites
# and in-house IT, so they're noise rather than leads. Matched as WHOLE WORDS
# (case-insensitive), so "Магнит" does not filter "Магнитогорская аптека".
# Keep entries specific: a needle that is also an ordinary word ("Метро",
# "Верный") silently filters out real independent businesses.
# Leave unset to use the built-in list in config.py.
# CHAIN_STOPLIST=Пятёрочка,Магнит,Сбербанк,Ozon,Wildberries,McDonalds,KFC
