# Copy to .env (same directory) and adjust. NEVER commit the real .env
# (already covered by the repo's .gitignore: workers/**/.env).
#
# On Windows, save as UTF-8 WITHOUT a BOM - a BOM becomes part of the first
# variable's name and that variable silently goes missing. (config.py reads
# .env as utf-8-sig so it tolerates one anyway.)

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# --- Volume ---
# Companies per GET /api/v1/companies/pending-enrich.
ENRICH_BATCH=50
# Batches one run may take; the run stops earlier as soon as the queue is empty.
MAX_BATCHES_PER_RUN=10
# Sites processed at the same time.
ENRICH_CONCURRENCY=5

# --- Politeness ---
# Pause between two requests to the same site, and between two sites handled
# by the same concurrency slot. A site's robots.txt Crawl-delay wins when it
# is larger, up to MAX_CRAWL_DELAY_SECONDS.
REQUEST_DELAY_SECONDS=2.0
MAX_CRAWL_DELAY_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15

# Keep true. false = robots.txt is not even downloaded; acceptable ONLY for
# checking a site you own. See README.md "robots.txt".
RESPECT_ROBOTS=true

# Name + purpose, no browser disguise. The first token is what a robots.txt
# "User-agent:" line addresses us by.
USER_AGENT=qorsa-leadgen-enrich/1.0 (contact enrichment bot; reads public contact pages only; respects robots.txt)

# --- Per-site limits ---
# Contact/about pages followed from the homepage (the homepage is always read).
MAX_CONTACT_PAGES=3
# Pages are truncated past this many bytes.
MAX_PAGE_BYTES=2000000

# true = one run and exit (good for a scheduled task).
# false = loop forever, sleeping LOOP_INTERVAL_MINUTES between runs.
RUN_ONCE=true
LOOP_INTERVAL_MINUTES=60
