CORE_URL=http://localhost:8081
LOG_LEVEL=INFO

# PageSpeed Insights. Leave empty to run the local probe only (auditFails
# gets reported, pagespeed does not).
#
# PSI is NOT the Places API: it is free, 25 000 requests/day, and does NOT
# require an activated billing account. Enable "PageSpeed Insights API" in
# the Google Cloud console and create an API key. Without a key PSI answers
# anonymously but rate-limits on the first request (verified: 429).
PSI_API_KEY=
PSI_STRATEGY=mobile
PSI_TIMEOUT_SECONDS=90
PSI_MAX_PER_RUN=200

# --- volume ---
AUDIT_BATCH=50
MAX_BATCHES_PER_RUN=10
AUDIT_CONCURRENCY=3

# --- politeness (local probe: exactly one request per site) ---
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15
RESPECT_ROBOTS=true
USER_AGENT=qorsa-leadgen-audit/1.0 (site quality probe; reads the homepage only; respects robots.txt)
MAX_PAGE_BYTES=3000000

# --- local probe thresholds ---
SLOW_RESPONSE_SECONDS=3.0
HEAVY_PAGE_BYTES=2000000

RUN_ONCE=true
LOOP_INTERVAL_MINUTES=180
