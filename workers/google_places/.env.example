# Copy to .env (same directory) and fill in. NEVER commit the real .env -
# it's already covered by the repo's .gitignore (workers/**/.env).

# From Google Cloud Console - see README.md for the full setup, INCLUDING
# the billing account requirement. Leave blank to run this worker with
# everything else already set up except billing - it will log a friendly
# message and exit instead of crashing.
GOOGLE_PLACES_API_KEY=

# Base URL of the qorsa_leadgen Java core.
CORE_URL=http://localhost:8081

LOG_LEVEL=INFO

# Max companies to ingest in one run (spread across all city x category
# pairs) - Places API (New) bills per request, treat this as a cost guard.
TARGET_PER_DAY=300

# true = one pass and exit (good for a daily cron job).
# false = loop forever, sleeping LOOP_INTERVAL_HOURS between passes.
RUN_ONCE=true
LOOP_INTERVAL_HOURS=24

MAX_PAGES_PER_QUERY=3
REQUEST_DELAY_SECONDS=1.0
PAGE_TOKEN_DELAY_SECONDS=2.0
