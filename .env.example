# Copy to .env and adjust if needed. Values here must match application.yml
# defaults (or be exported into the environment before running the app).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=qorsa_leadgen
DB_USER=qorsa
DB_PASSWORD=qorsa

# 8081, not 8080 - 8080 is commonly already taken (Apache/Tomcat). Every
# worker's CORE_URL default points at this port; change both or neither.
SERVER_PORT=8081

# Google Sheets export (kz.qorsa.leadgen.export) - optional. Leave both
# blank to run without it (one WARN at startup, core works normally).
# See README.md "Экспорт лидов в Google Sheets" for setup steps.
GOOGLE_CREDENTIALS_PATH=
SHEETS_SPREADSHEET_ID=
SHEETS_SYNC_DELAY_MS=300000
