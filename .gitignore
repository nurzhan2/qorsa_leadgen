target/
*.class

# IDE
.idea/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
bin/

# OS
.DS_Store
Thumbs.db

# Env
.env
workers/**/.env

# Logs
*.log

# Python workers
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Telethon session files - equivalent to a logged-in credential, never commit
*.session
*.session-journal

# Google service-account credentials (Sheets export) - never commit
credentials/*.json

# Generated report, not source (workers/telegram_monitor/channel_rater.py)
workers/telegram_monitor/channel_report.csv

# Resolved-channel cache - machine-local state (peer ids/access hashes tied to
# one account's session), rebuilt on demand. Never commit.
workers/telegram_monitor/channel_cache.json
workers/telegram_monitor/channel_cache.json.tmp

# OSM crawl checkpoint - per-machine run state (which city/category pairs are
# done), not source. Deleting it just restarts the sweep.
workers/osm/osm_progress.json
workers/osm/osm_progress.json.tmp
